    "tryOnDisclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI images are visual approximations, not a fit or size guarantee. Until generated, the default model is shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI效果图仅供参考，不保证实际合身或尺码。生成前显示默认模特。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI效果圖僅供參考，不保證實際合身或尺寸。產生前顯示預設模特。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI画像は参考イメージです。サイズやフィット感を保証しません。生成前は既定モデルを表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images IA sont indicatives et ne garantissent pas la taille. Le mannequin par défaut apparaît avant la génération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Bilder sind unverbindliche Ansichten ohne Größen- oder Passformgarantie. Bis zur Erstellung erscheint das Standardmodell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes IA son orientativas y no garantizan talla ni ajuste. Antes de generarlas se muestra el modelo predeterminado."
          }
        }
      }
    },
