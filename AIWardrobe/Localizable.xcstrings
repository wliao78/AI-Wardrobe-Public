    "textConsentDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For outfit advice, the selected provider receives clothing names, categories, colors, your recent messages, app language and temperature (not coordinates). Your API key authenticates requests directly with that provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成搭配建议时，所选服务商将收到衣物名称、类别、颜色、近期对话、应用语言和温度（不含坐标）。API Key仅用于向该服务商验证请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生搭配建議時，所選服務商將收到衣物名稱、類別、顏色、近期對話、應用語言和溫度（不含座標）。API Key僅用於向該服務商驗證請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案には衣服名・種類・色・最近の会話・言語・気温（座標を除く）を選択した提供者に送ります。APIキーはその提供者への認証に使います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prestataire reçoit noms, catégories et couleurs des vêtements, messages récents, langue et température, sans coordonnées. La clé sert à l’authentification directe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter erhält Kleidungsnamen, Kategorien, Farben, letzte Nachrichten, Sprache und Temperatur, keine Koordinaten. Der API-Schlüssel authentifiziert direkt beim Anbieter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor recibe nombres, categorías y colores, mensajes recientes, idioma y temperatura, sin coordenadas. La clave autentica directamente con ese proveedor."
          }
        }
      }
    },
    "allowText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow outfit data sharing"
          }
        },
        "zh-Hans": {
