    "revokeNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional and off by default. Save to apply. You can revoke permission at any time. Changing provider or endpoint requires fresh consent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选，默认关闭。保存后生效，可随时撤销。更换服务商或地址需要重新授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選，預設關閉。儲存後生效，可隨時撤銷。更換服務商或網址需要重新授權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意で初期状態はオフ。保存して適用。いつでも撤回可能。提供者やURLの変更には再同意が必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif et désactivé par défaut. Enregistrez pour appliquer. Révocable à tout moment. Un autre prestataire nécessite un nouvel accord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional und standardmäßig aus. Zum Anwenden speichern. Jederzeit widerrufbar. Anbieterwechsel erfordert neue Zustimmung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional y desactivado por defecto. Guarda para aplicar. Puedes revocarlo cuando quieras. Cambiar de proveedor requiere nuevo permiso."
          }
        }
      }
    },
    "revokeConsent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
