            "state": "translated",
            "value": "語音輸入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisie vocale"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracheingabe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada de voz"
          }
        }
      }
    },
    "stopVoice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop listening"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止录音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止錄音"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を停止"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter l’écoute"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener grabación"
          }
        }
      }
    },
    "voiceListening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening… tap to stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在听，请点按停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在聆聽，點按可停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中…タップで停止"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute… touchez pour arrêter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme… zum Beenden tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando… toca para detener"
          }
        }
      }
    },
    "speechPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow speech recognition in Settings, or continue typing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许语音识别，或继续使用文字输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許語音辨識，或繼續使用文字輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で音声認識を許可するか、文字で入力してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la reconnaissance vocale dans Réglages, ou utilisez le clavier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennung in Einstellungen erlauben oder weiter tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el reconocimiento de voz en Ajustes o escribe el texto."
          }
        }
      }
    },
    "microphonePermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in Settings, or continue typing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许麦克风，或继续使用文字输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許麥克風，或繼續使用文字輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でマイクを許可するか、文字で入力してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le microphone dans Réglages, ou utilisez le clavier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon in Einstellungen erlauben oder weiter tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el micrófono en Ajustes o escribe el texto."
          }
        }
      }
    },
    "microphoneUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone input is available. Check your audio input and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有可用的麦克风输入，请检查音频输入后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有可用的麥克風輸入，請檢查音訊輸入後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイク入力を利用できません。音声入力を確認して再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun microphone disponible. Vérifiez l’entrée audio et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Mikrofoneingang verfügbar. Audioeingang prüfen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay entrada de micrófono. Comprueba la entrada de audio y reinténtalo."
          }
        }
      }
    },
    "speechUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is unavailable. Try again or continue typing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前语音识别不可用，请重试或使用文字输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前語音辨識不可用，請重試或使用文字輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識を利用できません。再試行するか文字で入力してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaissance vocale indisponible. Réessayez ou utilisez le clavier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennung nicht verfügbar. Erneut versuchen oder tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocimiento de voz no disponible. Reinténtalo o escribe el texto."
          }
        }
      }
    },
    "speechStartFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone could not start. Check your audio device and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风启动失败，请检查音频设备后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風啟動失敗，請檢查音訊裝置後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを開始できません。音声機器を確認して再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le microphone. Vérifiez l’appareil audio et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon konnte nicht starten. Audiogerät prüfen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el micrófono. Comprueba el dispositivo de audio y reinténtalo."
          }
        }
      }
    },
