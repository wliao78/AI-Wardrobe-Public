    "bodyPhotoNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Add front, left, right and back photos to use your own appearance. Stored on this iPhone; shared only with explicit AI photo consent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。上传正面、左侧、右侧和背面照后使用个人形象。照片保存在本机，仅在明确同意AI图片处理后发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選。上傳正面、左側、右側和背面照後使用個人形象。照片保存在本機，僅在明確同意AI圖片處理後傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。前・左・右・後ろの写真を追加すると自分の姿を使えます。端末に保存し、明示的な同意後のみAIに送信します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Ajoutez les quatre vues pour utiliser votre apparence. Photos locales, envoyées à l’IA uniquement avec votre accord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Füge Vorder-, Seiten- und Rückansichten hinzu. Fotos bleiben auf dem iPhone und werden nur mit ausdrücklicher Zustimmung an KI gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Añade las cuatro vistas para usar tu apariencia. Las fotos se guardan en el iPhone y solo se envían a la IA con tu permiso."
          }
        }
      }
    },
