    "apiCostNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: bring your own API key. Provider charges may apply, including a small connection test. This app does not sell API access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：使用自己的API Key。服务商可能收费，连接测试也可能产生少量费用。本应用不销售API访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選：使用自己的API Key。服務商可能收費，連線測試也可能產生少量費用。本應用不銷售API存取權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のAPIキーを設定できます。接続テストを含め提供者の料金が発生する場合があります。本アプリはAPIアクセスを販売しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API personnelle facultative. Le prestataire peut facturer les requêtes et le test. L’app ne vend pas d’accès API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionaler eigener API-Schlüssel. Der Anbieter kann Anfragen und Tests berechnen. Die App verkauft keinen API-Zugang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave API propia opcional. El proveedor puede cobrar consultas y pruebas. La app no vende acceso a API."
          }
        }
      }
    },
