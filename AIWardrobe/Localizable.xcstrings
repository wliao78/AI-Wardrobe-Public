    "localeNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language, units and default models follow your iPhone settings. Models are fictional examples; you can choose any region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言、单位及默认模特跟随手机设置。模特为虚构示例，可自由选择地区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語言、單位及預設模特跟隨手機設定。模特為虛構示例，可自由選擇地區。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語・単位・モデルはiPhoneの設定に従います。モデルは架空で、地域は自由に選べます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue, les unités et les mannequins suivent l’iPhone. Les mannequins sont fictifs ; choisissez librement une région."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache, Einheiten und Modelle folgen den iPhone-Einstellungen. Die Modelle sind fiktiv; jede Region ist frei wählbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma, las unidades y los modelos siguen al iPhone. Los modelos son ficticios; puedes elegir cualquier región."
          }
        }
      }
    },
