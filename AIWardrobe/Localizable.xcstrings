    "photoConsentDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you tap AI image, the selected provider also receives the chosen model or your front photo and selected clothing photos. Images may contain your face and body. Retention and processing follow that provider’s policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击AI效果图时，所选服务商还将收到模特图或你的正面照，以及所选衣物照片。图片可能包含面部与身体；处理及保留期限遵循该服务商政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊AI效果圖時，所選服務商還將收到模特圖或你的正面照，以及所選衣物照片。圖片可能包含臉部與身體；處理及保留期限遵循該服務商政策。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI画像を押すとモデル画像または自分の正面写真と衣服写真を送信します。顔や身体が含まれる場合があります。保存期間は提供者の方針に従います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En touchant Image IA, vous envoyez aussi le mannequin ou votre photo de face et les vêtements sélectionnés. Visage et corps peuvent être visibles. Conservation selon le prestataire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei KI-Bild werden zusätzlich Modell- oder eigenes Vorderfoto und Kleidungsfotos gesendet. Gesicht und Körper können sichtbar sein. Speicherung gemäß Anbieterrichtlinie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pulsar Imagen IA se envían el modelo o tu foto frontal y las prendas elegidas. Pueden incluir rostro y cuerpo. La conservación depende del proveedor."
          }
        }
      }
    },
