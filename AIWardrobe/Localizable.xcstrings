    "deleteAllWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes clothing, photos, looks, chats, settings and all saved API keys. This cannot be undone. Provider-held data must be managed with that provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除衣物、照片、搭配、对话、设置和所有API Key，无法撤销。服务商保留的数据需向其管理或申请删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除衣物、照片、搭配、對話、設定和所有API Key，無法復原。服務商保留的資料需向其管理或申請刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "衣服・写真・コーデ・会話・設定・APIキーを削除します。元に戻せません。送信済みデータは提供者に削除を依頼してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime vêtements, photos, tenues, discussions, réglages et clés API. Irréversible. Gérez les données déjà envoyées auprès du prestataire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Kleidung, Fotos, Outfits, Chats, Einstellungen und API-Schlüssel unwiderruflich. Bereits übermittelte Daten beim Anbieter verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina prendas, fotos, conjuntos, chats, ajustes y claves API. No se puede deshacer. Gestiona los datos enviados con el proveedor."
          }
        }
      }
    },
    "localStorageNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, ads or tracking. Your wardrobe stays on this iPhone. No cloud sync or app-data backup in this edition."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号，无广告和跟踪。衣橱保存在此iPhone，本版不提供云同步或应用数据备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需帳號，無廣告和追蹤。衣櫥保存在此iPhone，本版不提供雲端同步或應用資料備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント・広告・追跡なし。データはこのiPhoneに保存。クラウド同期・アプリデータのバックアップはありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans compte, publicité ni suivi. Données sur cet iPhone, sans synchronisation ni sauvegarde de l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Konto, Werbung oder Tracking. Daten bleiben auf diesem iPhone, ohne Cloud-Sync oder App-Datensicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, anuncios ni rastreo. Datos en este iPhone, sin sincronización ni copia de seguridad de la app."
          }
        }
      }
    },
